{
  "name": "dsh-baton",
  "version": "0.1.0",
  "description": "交接卡片收件箱：把当前 DSH 会话按 handoff: 1 开放协议寄存进 ~/.handoff/pending/，任何 agent 开局可取件",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.yml": "./cordis.yml",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.yml",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx/esm --test tests/*.spec.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.7-rc.2"
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "handoff",
    "session-handoff",
    "inbox",
    "agent-handoff"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.7-rc.2",
    "@deepseek-ai/dsh-skill": ">=0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": ">=0.1.7-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@agent-handoff/core": "file:../agent-handoff/packages/core",
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.1.7-rc.2",
    "@deepseek-ai/dsh-skill": "0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.2",
    "@types/node": "^22.10.0",
    "tsdown": "^0.22.14",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
